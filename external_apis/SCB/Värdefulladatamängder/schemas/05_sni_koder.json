{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCB SNI-kod Schema",
  "description": "Standard för svensk näringsgrensindelning (SNI 2007). Upp till 5 SNI-koder per företag (Ng1-Ng5).",
  "type": "object",
  "definitions": {
    "sniKod": {
      "type": "string",
      "pattern": "^[0-9]{5}$",
      "description": "5-siffrig SNI-kod enligt SNI 2007-standarden"
    }
  },
  "properties": {
    "Ng1": {
      "$ref": "#/definitions/sniKod",
      "description": "Primär SNI-kod (huvudsaklig näringsverksamhet)"
    },
    "Ng2": {
      "$ref": "#/definitions/sniKod",
      "description": "Sekundär SNI-kod (binäringsverksamhet 1)"
    },
    "Ng3": {
      "$ref": "#/definitions/sniKod",
      "description": "Tertiär SNI-kod (binäringsverksamhet 2)"
    },
    "Ng4": {
      "$ref": "#/definitions/sniKod",
      "description": "Kvartär SNI-kod (binäringsverksamhet 3)"
    },
    "Ng5": {
      "$ref": "#/definitions/sniKod",
      "description": "Kvintär SNI-kod (binäringsverksamhet 4)"
    }
  },
  "sniStructure": {
    "description": "SNI-koden är hierarkisk och strukturerad enligt följande nivåer",
    "levels": {
      "sektion": {
        "description": "Översta nivån (A-U)",
        "example": "G - Handel; serviceverksamhet avseende motorfordon och motorcyklar"
      },
      "avdelning": {
        "description": "Andra nivån (2 siffror)",
        "example": "47 - Detaljhandel utom med motorfordon och motorcyklar"
      },
      "grupp": {
        "description": "Tredje nivån (3 siffror)",
        "example": "471 - Detaljhandel med brett sortiment"
      },
      "klass": {
        "description": "Fjärde nivån (4 siffror)",
        "example": "4711 - Detaljhandel med brett sortiment, med livsmedel som huvudsaklig vara"
      },
      "underklass": {
        "description": "Femte nivån (5 siffror) - används i SCB-data",
        "example": "47110 - Detaljhandel med brett sortiment, med livsmedel som huvudsaklig vara"
      }
    }
  },
  "examples": [
    {
      "Ng1": "47110",
      "description": "Livsmedelsbutik (huvudverksamhet)",
      "Ng2": "47300",
      "description": "Detaljhandel med drivmedel (binäring)"
    },
    {
      "Ng1": "62010",
      "description": "Dataprogrammering (huvudverksamhet)",
      "Ng2": "62020",
      "description": "Datakonsultverksamhet (binäring)",
      "Ng3": "63110",
      "description": "Databehandling och hosting (binäring 2)"
    }
  ],
  "metadata": {
    "source": "SCB Värdefulladatamängder",
    "lastUpdated": "2025-10-26",
    "standard": "SNI 2007 (Standard för svensk näringsgrensindelning)",
    "fields": ["Ng1", "Ng2", "Ng3", "Ng4", "Ng5"],
    "externalReference": "https://www.scb.se/vara-tjanster/klassificeringar-och-standarder/standard-for-svensk-naringsgrensindelning-sni/",
    "usage": "Klassificering av företagets näringsverksamhet. Ng1 är huvudsaklig verksamhet, Ng2-Ng5 är binäringar."
  }
}
